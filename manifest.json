{
  "manifest_version": 2,
  "name": "Cobalt Media Downloader",
  "version": "1.3.0",
  "description": "Baixe mídia dos sites suportados pelo Cobalt via API oficial (imputnet/cobalt). Configure sua instância e baixe por clique, menu de contexto ou popup.",
  "homepage_url": "https://github.com/imputnet/cobalt",
  "author": "community",
  "browser_specific_settings": {
    "gecko": {
      "id": "cobalt-media-downloader@example.local",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["websiteActivity"]
      }
    }
  },
  "background": {
    "scripts": ["cobalt.js", "background.js"],
    "persistent": false
  },
  "browser_action": {
    "default_title": "Baixar com Cobalt",
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": [
    "menus",
    "contextMenus",
    "tabs",
    "storage",
    "downloads",
    "notifications",
    "nativeMessaging",
    "alarms",
    "clipboardWrite",
    "<all_urls>"
  ],
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  }
}
